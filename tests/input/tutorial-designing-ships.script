# Tutorial 4, "Designing ships", played through under the input lock
# (docs/BUILDING.md "Input scripts").
# layouts: both (also plays at 800x600: run_input_tests.py --small)
options --tutorial=designing-ships --layout=1024x768 --size=1280x800

wait-lesson designing-ships
# 1 Your own ships.
click item:Next in=lesson
wait-step 2
# 2 The Designs window.
click tag:command:designs
wait-window designs
wait-step 3
# 3 Your designs: click one of them, look at the unit designs, back to ships, Next. The
# details are shown, not used.
click tag:designs:details refused
click item:##row in=designs nth=2
click tag:designs:unit-designs
click tag:designs:ship-designs
click item:Next in=lesson
wait-step 4
# 4 A new design: Create, then Ship. Base (or any other kind) is refused.
click tag:designs:create
wait-for tag:designs:create:ship
click tag:designs:create:base refused
assert-step 4
click item:Ship in=designs
wait-window create-design
wait-step 5
# 5 Choose a hull: the arrow beside Size, then the smallest hull; a larger one is refused.
click item:##size in=create-design
wait-for tag:create-design:hull:smallest
click tag:create-design:hull:other refused
click tag:create-design:hull:smallest
wait-step 6
assert { design_hull_chosen = true }
# 6 Choose a type: the arrow beside Design Type, then Attack Ship; another type is refused.
click item:##type in=create-design
wait-for tag:create-design:type:attack-ship
click tag:create-design:type:defense-base refused
click item:"Attack Ship"
wait-step 7
assert { design_type_chosen = "Attack Ship" }
# 7 Add components: the tiles of Components Available, by their place in the stock data set:
# bridge (2), life support (3), crew quarters (4), two engines (8), then two weapons (14, 15).
click item:##tile in=create-design nth=2
click item:##tile in=create-design nth=3
click item:##tile in=create-design nth=4
click item:##tile in=create-design nth=8
click item:##tile in=create-design nth=8
wait-step 8
# 8 Check the rules: more components, then Next. The grid shows three rows of three: two
# clicks on its down arrow bring tiles 7 to 15 into view, so the weapons (14, 15) are the
# eighth and ninth tiles shown.
click item:##down in=tag:create-design:components
click item:##down in=tag:create-design:components
click item:##tile in=create-design nth=8
click item:##tile in=create-design nth=9
assert { design_components = 7 }
click item:Next in=lesson
wait-step 9
# 9 Name it: type a name into the Design Name box; the step moves on once the box holds a name
# no other design has, and the name can be finished in the next step.
click tag:create-design:name
type "Lesson Warship"
wait-step 10
assert { design_named = true }
# 10 Create it.
click tag:create-design:save
wait-closed create-design
wait-step 11
assert { command = "CreateDesign", design_type = "Attack Ship" }
# 11 Managing designs: the new design is in the list; close the window.
assert-present item:"Lesson Warship" in=designs
click item:"Lesson Warship" in=designs
click tag:designs:close
wait-closed designs
wait-step 12
# 12 Build it: the homeworld (colony arrows), then the Build Queue order.
click item:next in=tag:cycle:colony
click tag:order:build-queue
wait-window set-queue
wait-step 13
# 13 Queue your warship: the new design on the Ships tab, as the panel names it; another
# design's row is refused.
wait-for item:"Lesson Warship" in=set-queue
assert-inside item:"Lesson Warship" in=set-queue tag:set-queue:available:named
click tag:set-queue:available:other refused
click item:"Lesson Warship" in=set-queue
wait-step 14
assert { construction_queued = 1 }
assert { command = "QueueAdd", design_type = "Attack Ship" }
# 14 Well done: Finish.
click item:Finish in=lesson
wait-result done
assert-present item:"Next: Fleets, movement and supply*"
click item:"Keep Playing"
wait-gone item:"Keep Playing"
