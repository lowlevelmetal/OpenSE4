 #define MICROPY_VM_HOOK_RETURN
 #endif
 
+// Hook called before each bytecode is dispatched (it may RAISE an exception as if
+// that bytecode had raised it).
+#ifndef MICROPY_VM_HOOK_OPCODE
+#define MICROPY_VM_HOOK_OPCODE
+#endif
+
+// Charges native work to a port's execution budget; may raise.
+#ifndef MICROPY_BUDGET_CHARGE
+#define MICROPY_BUDGET_CHARGE(units) ((void)0)
+#endif
+
+// Charges native work without raising (for places where raising would leave a
+// structure half-built); the next bytecode or charge reports an exhausted budget.
+#ifndef MICROPY_BUDGET_DEBIT
+#define MICROPY_BUDGET_DEBIT(units) ((void)0)
+#endif
+
+// Python call depth: checked (may raise) before a bytecode function or generator
+// runs, counted around its execution.
+#ifndef MICROPY_CALL_DEPTH_CHECK
+#define MICROPY_CALL_DEPTH_CHECK() ((void)0)
+#define MICROPY_CALL_DEPTH_ENTER() ((void)0)
+#define MICROPY_CALL_DEPTH_EXIT() ((void)0)
+#endif
+
+// Hashing. MICROPY_HASH_MASK limits every hash; MICROPY_HASH_INT_MODULUS, when
+// non-zero, hashes an integer of any size as its value modulo this number, so that
+// small and big representations agree on every word size.
+#ifndef MICROPY_HASH_MASK
+#define MICROPY_HASH_MASK (MP_SMALL_INT_POSITIVE_MASK)
+#endif
+#ifndef MICROPY_HASH_INT_MODULUS
+#define MICROPY_HASH_INT_MODULUS (0)
+#endif
+
+// The identity of an object without a value hash, for hash() and id(). The default
+// is its address; a port may number objects instead.
+#ifndef MICROPY_OBJ_IDENTITY
+#define MICROPY_OBJ_IDENTITY(o) ((mp_uint_t)(o))
+#endif
+#ifndef MICROPY_OBJ_ID_VALUE
+#define MICROPY_OBJ_ID_VALUE(o) ((mp_uint_t)(o))
+#endif
+// The identity stored in each new class instance (0: none, use the default).
+#ifndef MICROPY_OBJ_NEW_IDENTITY
+#define MICROPY_OBJ_NEW_IDENTITY() (0)
+#endif
+
