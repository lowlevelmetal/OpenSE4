# Tutorial 1, "First steps", played through under the input lock: every step
# done by clicking what it tells the player to click (docs/BUILDING.md "Input scripts").
# layouts: both (also plays at 800x600: run_input_tests.py --small)
options --tutorial=first-steps --layout=1024x768 --size=1280x800

wait-lesson first-steps
assert-step 1
# 1 Welcome, 2 Your empire: explanations.
click item:Next in=lesson
wait-step 2
click item:Next in=lesson
wait-step 3
# 3 Your home system: an empty part of the system view. The report is only to read: a ship of
# its list (in the homeworld's sector) cannot be selected or tagged from it, nor given a Move To
# with a right-click on the system view.
click tag:sector:home
wait-for item:report:ship in=main
click item:report:ship in=main refused
click item:report:ship in=main shift refused
right-click sector:planet+!colony refused
assert { not = { order = "move-to" } }
click sector:empty
wait-step 4
# 4 Your homeworld: the outlined homeworld; its sector lists everything there, then the
# homeworld in that list (outlined too once it shows).
click tag:sector:home
# The report shows the whole list; only the homeworld's row can be clicked.
wait-for tag:report:colony
click item:report:ship in=main refused
click tag:report:colony
wait-step 5
# 5 The planet report: its tabs, then Next.
click item:Facil in=main
click item:Ability in=main
click item:Detail in=main
click item:Next in=lesson
wait-step 6
# 6 Other planets. The report's list and right-clicks on the system view are refused.
click tag:sector:home
wait-for item:report:ship in=main
click item:report:ship in=main refused
right-click sector:empty nth=40 refused
assert { not = { order = "move-to" } }
click sector:planet+!colony
wait-step 7
# 7 The galaxy panel: a right click opens the Galaxy Map; a left click (which would show another
# system and clear the selection) is refused.
click tag:panel:galaxy refused
right-click tag:panel:galaxy
wait-window galaxy-map
wait-step 8
# 8 The overlays switch; the map's notes and Goto System are not this step's. Then Close.
click item:Spaceports in=galaxy-map
click item:"Goto System" in=galaxy-map refused
click tag:galaxy-map:map refused
click item:Presence in=galaxy-map
click tag:galaxy-map:close
wait-closed galaxy-map
wait-step 9
# 9 The command buttons: an explanation.
move tag:command:designs
click item:Next in=lesson
wait-step 10
# 10 Help.
click tag:command:help
wait-window help
wait-step 11
# 11 Help topics: a few tabs and an item, then Close.
click item:Facilities in=help
click item:Components in=help
click tag:help:close
wait-closed help
wait-step 12
# 12 Your ships: the right arrow of the ship selector.
click item:next in=tag:cycle:ship
wait-step 13
# 13 The orders: an explanation; point at the outlined orders.
move tag:order:move-to
move tag:order:explore
click item:Next in=lesson
wait-step 14
# 14 End the turn, and answer Yes.
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 1
wait-step 15
# 15 Well done: the Log opens with its button, its categories and messages can be read, and the
# rest of it (Constr. Queues, which leads to a queue) is refused; Close.
click tag:command:log
wait-window log
wait 3
click item:"Constr. Queues" in=log refused
assert-no-window queues
click tag:log:close
wait-closed log
assert-present item:Finish in=lesson
click item:Finish in=lesson
wait-result done
assert-present item:"Keep Playing"
assert-present item:"Next Lesson"
assert-present item:"Next: Exploring and colonizing*"
click item:"Keep Playing"
wait-gone item:"Keep Playing"
assert-result done
