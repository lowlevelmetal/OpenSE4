# End Turn while a window is open (docs/BUILDING.md "Input scripts"): the "End the turn
# now?" question comes up over the window and takes the input (it used to open behind
# it). Esc answers No and leaves the window open; Y ends the turn.
options --quick-start=Terran --seed=404 --open=none --layout=1024x768 --size=1280x800

wait-screen game
key F5
wait-window colonies
click tag:button:end-turn
wait-for item:Yes in="End Turn"
key Escape
wait-gone item:Yes in="End Turn"
assert-window colonies
assert-turn 0
click tag:button:end-turn
wait-for item:No in="End Turn"
click item:No in="End Turn"
wait-gone item:No in="End Turn"
assert-window colonies
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 1
