OpenSE4: MSVC refuses the constant division 0/0.0 (error C2124); the same NaN from a
run-time expression, for the Windows builds made with Visual Studio.

--- a/lib/libm_dbl/tgamma.c
+++ b/lib/libm_dbl/tgamma.c
@@ -125,7 +125,7 @@
 	/* raise inexact when non-integer */
 	if (x == floor(x)) {
 		if (sign)
-			return 0/0.0;
+			return (x - x) / (x - x);  /* NaN; MSVC refuses a constant 0/0.0 */
 		if (x <= sizeof fact/sizeof *fact)
 			return fact[(int)x - 1];
 	}
