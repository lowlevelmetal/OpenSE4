 /* map                                                                        */
 
+#if MICROPY_MAP_INSERTION_ORDER
+// A hash map keeps its entries in the order they were added, as CPython's dicts
+// do: table[0, alloc) holds the entries (a deleted one keeps its place, with a
+// SENTINEL key; entries past the used ones have a NULL key), so iterating over the
+// table as before visits them in insertion order. After the entries, in the same
+// block: the number of entries used so far, their hashes, and an open-addressing
+// index from hash to entry number + 1 (0: empty, MAP_INDEX_DUMMY: deleted).
+// Ordered maps (OrderedDict, fixed tables) are linear arrays, as before.
+#define MAP_INDEX_DUMMY (0xffffffffu)
+
+static size_t map_index_size(size_t alloc) {
+    size_t n = 4;
+    while (n < alloc + alloc / 2 + 1) {
+        n *= 2;
+    }
+    return n;
+}
+
+static size_t map_block_bytes(size_t alloc) {
+    return alloc * sizeof(mp_map_elem_t) + sizeof(uint32_t) * (1 + alloc + map_index_size(alloc));
+}
+
+static inline uint32_t *map_meta(const mp_map_t *map) {
+    return (uint32_t *)(void *)(map->table + map->alloc);
+}
+#define MAP_FILLED(map) (map_meta(map)[0])
+#define MAP_HASHES(map) (map_meta(map) + 1)
+#define MAP_INDEX(map) (map_meta(map) + 1 + (map)->alloc)
+
+// Moves the live entries, in order, into a new block of `alloc` entries. Allocation
+// happens first, so a MemoryError leaves the map as it was; nothing else can fail.
+static void map_rebuild(mp_map_t *map, size_t alloc) {
+    mp_map_elem_t *old = map->table;
+    uint32_t old_filled = old != NULL ? MAP_FILLED(map) : 0;
+    const uint32_t *old_hashes = old != NULL ? MAP_HASHES(map) : NULL;
+    mp_map_elem_t *table = m_malloc0(map_block_bytes(alloc));
+    map->table = table;
+    map->alloc = alloc;
+    uint32_t *hashes = MAP_HASHES(map);
+    uint32_t *index = MAP_INDEX(map);
+    size_t mask = map_index_size(alloc) - 1;
+    uint32_t n = 0;
+    for (uint32_t i = 0; i < old_filled; i++) {
+        if (old[i].key != MP_OBJ_NULL && old[i].key != MP_OBJ_SENTINEL) {
+            table[n] = old[i];
+            hashes[n] = old_hashes[i];
+            size_t pos = hashes[n] & mask;
+            while (index[pos] != 0) {
+                pos = (pos + 1) & mask;
+            }
+            index[pos] = n + 1;
+            n++;
+        }
+    }
+    MAP_FILLED(map) = n;
+    if (old != NULL) {
+        m_free(old);
+    }
+}
+
+size_t mp_map_table_bytes(const mp_map_t *map) {
+    if (map->is_ordered || map->table == NULL) {
+        return map->alloc * sizeof(mp_map_elem_t);
+    }
+    return map_block_bytes(map->alloc);
+}
+#else
+size_t mp_map_table_bytes(const mp_map_t *map) {
+    return map->alloc * sizeof(mp_map_elem_t);
+}
+#endif
