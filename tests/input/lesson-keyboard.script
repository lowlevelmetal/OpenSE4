# Keyboard navigation under the tutorial input lock (docs/LEARNING.md "The input lock";
# docs/BUILDING.md "Input scripts"): Ctrl+Tab (which would bring another window to the front)
# is refused, even while a text field has the keyboard; Tab only moves between the fields of the
# window in front; and Space or Enter never press a button the keyboard went to. A key the step
# allows still works: tutorial 5's step 12 takes Ctrl+F (the next fleet). The manual's search
# field is the text field.
# layouts: both (also plays at 800x600: run_input_tests.py --small)
options --tutorial=fleets-and-movement --layout=1024x768 --size=1280x800

wait-lesson fleets-and-movement
click item:Next in=lesson
wait-step 2
click item:next in=tag:cycle:ship
wait-step 3
click tag:order:fleet-transfer
wait-window fleet-transfer
wait-step 4
click tag:fleet-transfer:create-fleet
click item:OK in="Create Fleet"
wait-step 5
wait-for tag:fleet-transfer:ships:named
click tag:fleet-transfer:ships:named
wait 5
click tag:fleet-transfer:ships:named
wait-step 6
click tag:fleet-transfer:close
wait-closed fleet-transfer
click item:next in=tag:cycle:ship
wait-step 7
click tag:order:move-to
wait-step 8
click sector:empty nth=150
wait-step 9
key Ctrl+L
wait-step 10
click item:Next in=lesson
wait-step 11
key Alt+1
click sector:warp-point
wait-step 12
# Step 12 takes Space. First the manual, its search field, and the keys that move around.
click tag:lesson:read-more
wait-window manual
wait 5
click item:"##search" in=manual
wait 3
key Ctrl+Tab refused
key Tab
wait 5
key Ctrl+Tab refused
assert-window manual
# Esc leaves the field, a second one closes the manual (the window in front).
key Escape
wait 5
key Escape
wait-closed manual
wait 5
# Enter is End Turn in the main window: refused here, and so is Space (the ship cycle is not the
# step's). Ctrl+F is the step's (the next fleet), and does nothing else: no window opens, no
# turn ends.
key Enter refused
key Space refused
key Ctrl+F
wait 10
assert { selected = "fleet", design_type = "Attack Ship" }
assert-no-window manual
assert-no-window planets
assert-no-window fleet-transfer
assert-turn 0
wait-step 13
