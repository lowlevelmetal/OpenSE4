# Tutorial 5, "Fleets, movement and supply": the colony ship cannot be added to the new fleet by
# mistake. The step names the attack ship's row (its design, by a {design:Attack Ship} token): the
# input lock refuses the colony ship's row, and the fleet's own list, whose click would take the
# fleet's only ship out again; the attack ship joins (docs/LEARNING.md "Choices", docs/BUILDING.md
# "Input scripts"). The condition would not count the colony ship either: a fleet counts for
# design_type "Attack Ship" when one of its ships is one (tests/test_learn.cpp).
# layouts: both (also plays at 800x600: run_input_tests.py --small)
options --tutorial=fleets-and-movement --layout=1024x768 --size=1280x800

wait-lesson fleets-and-movement
click item:Next in=lesson
wait-step 2
click item:next in=tag:cycle:ship
wait-step 3
click tag:order:fleet-transfer
wait-window fleet-transfer
wait-step 4
click tag:fleet-transfer:create-fleet
click item:OK in="Create Fleet"
wait-step 5
# 5 The colony ship's row (the second ship outside fleets) is refused, with the note that says
# what the step waits for; the step waits.
wait-for tag:fleet-transfer:ships:named
assert-inside item:##row in=fleet-transfer nth=2 tag:fleet-transfer:ships:other
click item:##row in=fleet-transfer nth=2 refused
wait-for item:"note:*outline*"
wait 30
assert { not = { command = "JoinFleet" } }
assert-step 5
# The fleet's list only shows what is in the fleet.
click tag:fleet-transfer:fleets refused
assert-step 5
# The other attack ship (the first row outside fleets) joins: the step is done.
assert-inside item:##row in=fleet-transfer nth=1 tag:fleet-transfer:ships:named
click item:##row in=fleet-transfer nth=1
wait-step 6
assert { command = "JoinFleet", design_type = "Attack Ship" }
assert { not = { command = "JoinFleet", design_type = "Colony" } }
click tag:fleet-transfer:close
wait-closed fleet-transfer
click item:next in=tag:cycle:ship
wait-step 7
click tag:order:move-to
click sector:empty nth=150
wait-step 8
assert { order = "move-to", design_type = "Attack Ship" }
