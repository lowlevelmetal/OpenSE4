# Tutorial 2, "Exploring and colonizing", played through under the input lock
# (docs/BUILDING.md "Input scripts").
options --tutorial=exploring-and-colonizing --layout=1024x768 --size=1280x800

wait-lesson exploring-and-colonizing
# 1 Explore and expand.
click item:Next in=lesson
wait-step 2
# 2 The Planets window.
click tag:command:planets
wait-window planets
wait-step 3
# 3 Coloniz\Breathe.
click tag:planets:colonizable-breathable
wait-step 4
# 4 Send Colony Ship: pick the first planet of the list and Colonize.
click tag:planets:send-colony-ship
click item:* in="Select Planet to Colonize"
click item:Colonize in="Select Planet to Colonize"
wait-step 5
assert { order = "colonize" }
# 5 Select an attack ship: the right arrow of the ship selector (the colony ship, selected
# when it got its orders, is the last ship: the next one is an attack ship).
click item:next in=tag:cycle:ship
wait-step 6
# 6 Explore.
click tag:order:explore
wait-step 7
# 7 The second attack ship: the next ship, and Explore.
click item:next in=tag:cycle:ship
click tag:order:explore
wait-step 8
# 8 New systems: an explanation.
click item:Next in=lesson
wait-step 9
# 9 Founding the colony: End Turn and Yes; the colony ship arrives and settles.
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 1
wait-step 10
assert { colonies = 2 }
# 10 Your new colony: the Log the new turn opened is closed, and the new colony's type chosen
# (the suggested one, as the step says); then the Colonies window.
click tag:log:close
click item:"*(suggested)" in="Colony Type"
wait-gone item:"*(suggested)"
click tag:command:colonies
wait-window colonies
wait-step 11
# 11 A small start: an explanation.
click item:Next in=lesson
wait-step 12
# 12 Keep exploring: close the window (Esc), then end turns, sending each ship that has arrived
# exploring again, until five systems are explored.
key Escape
wait-closed colonies
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 2
wait 3
click tag:log:close optional
click item:next in=tag:cycle:ship
click tag:order:explore
click item:next in=tag:cycle:ship
click tag:order:explore
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 3
wait-step 13
wait 3
click tag:log:close optional
assert { systems_explored = 5 }
# 13 Well done: Finish, then the result's Next Lesson starts lesson 3.
click item:Finish in=lesson
wait-result done
assert-present item:"Next: Research and construction*"
click item:"Next Lesson"
wait-lesson research-and-construction
assert-step 1
