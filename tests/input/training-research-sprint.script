# Training game "Research sprint": its briefing pages, its first turns and Leave Game
# (docs/BUILDING.md "Input scripts").
# layouts: both (also plays at 800x600: run_input_tests.py --small)
options --training=research-sprint --layout=1024x768 --size=1280x800

wait-lesson research-sprint
wait-for tag:lesson:panel
assert-result none
# The briefing: two pages, browsed with Next and Previous, then closed.
assert-disabled item:Previous in=lesson
click item:Next in=lesson
wait-for item:Previous in=lesson
assert-disabled item:Next in=lesson
click item:Previous in=lesson
wait-for item:Next in=lesson
click item:"Close Page" in=lesson
assert-disabled item:"Close Page" in=lesson
# The first turn's work: four research projects queued (an objective).
click tag:command:research
wait-window research
click item:* in=research nth=12
click item:* in=research nth=10
click item:* in=research nth=1
click item:* in=research nth=2
assert { research_queued = 4 }
key Escape
wait-closed research
# Three turns; a hint that comes up is dismissed with OK.
repeat 3
  click tag:button:end-turn
  click item:Yes in="End Turn"
  wait 5
  click tag:log:close optional
  click item:OK in=lesson optional
end
assert-turn 3
assert-result none
# Leave Game, Yes: back to the Learn window's training games.
click item:"Leave Game" in=lesson
click item:Yes in="Leave Lesson"
wait-screen front
assert-present item:"Research sprint" in=front
