# Tutorial 2, "Exploring and colonizing", played through under the input lock
# (docs/BUILDING.md "Input scripts").
# layouts: both (also plays at 800x600: run_input_tests.py --small)
options --tutorial=exploring-and-colonizing --layout=1024x768 --size=1280x800

wait-lesson exploring-and-colonizing
# 1 Explore and expand.
click item:Next in=lesson
wait-step 2
# 2 The Planets window.
click tag:command:planets
wait-window planets
wait-step 3
# 3 Coloniz\Breathe; Colonizable is only to look at.
click tag:planets:colonizable refused
click tag:planets:colonizable-breathable
wait-step 4
# 4 Send Colony Ship: pick the first planet of the list and Colonize.
click tag:planets:send-colony-ship
click item:* in="Select Planet to Colonize"
click item:Colonize in="Select Planet to Colonize"
wait-step 5
assert { order = "colonize" }
# 5 Select an attack ship: the right arrow of the ship selector (the colony ship, selected
# when it got its orders, is the last ship: the next one is an attack ship).
click item:next in=tag:cycle:ship
wait-step 6
# 6 Explore. At 800x600 the order is on another page of the order strip: its outline lies on
# the page arrow, whose click shows the order, and a second click gives it. The selection stays:
# the ship arrows are not this step's.
click item:next in=tag:cycle:ship refused
repeat 2 until { order = "explore" }
  click tag:order:explore
end
wait-step 7
# 7 The second attack ship: the next ship. Explore is the next step's.
click tag:order:explore refused
click item:next in=tag:cycle:ship
wait-step 8
# 8 A second explorer: Explore.
click tag:order:explore
wait-step 9
# 9 New systems: an explanation.
click item:Next in=lesson
wait-step 10
# 10 Founding the colony: End Turn and Yes; the colony ship arrives and settles.
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 1
wait-step 11
assert { colonies = 2 }
# 11 Your new colony: its type chosen (the suggested one, as the step says) as it is founded
# at the turn's start, then the Log the new turn opened after it closed; then the Colonies
# window.
wait-for tag:colony-type:suggested
assert-no-window log
click tag:colony-type:other refused optional
click item:"*(suggested)" in="Colony Type"
wait-gone item:"*(suggested)"
click tag:log:close
# With the Log closed, Enter (End Turn in the main window) and Esc do nothing.
key Enter refused
key Escape refused
assert-turn 1
click tag:command:colonies
wait-window colonies
wait-step 12
# 12 A small start: an explanation.
click item:Next in=lesson
wait-step 13
# 13 Keep exploring: close the window (Esc), then end turns, sending each ship that has arrived
# exploring again, until five systems are explored. Once Colonies is closed, Esc does nothing
# more (it would clear the selection).
key Escape
wait-closed colonies
key Escape refused
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 2
wait 3
click tag:log:close optional
click item:next in=tag:cycle:ship
click tag:order:explore
click item:next in=tag:cycle:ship
click tag:order:explore
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 3
wait-step 14
wait 3
click tag:log:close optional
assert { systems_explored = 5 }
# 14 Well done: Finish, then the result's Next Lesson starts lesson 3.
click item:Finish in=lesson
wait-result done
assert-present item:"Next: Research and construction*"
click item:"Next Lesson"
wait-lesson research-and-construction
assert-step 1
