# Tutorial 7, "Diplomacy and intelligence", played through under the input lock
# (docs/BUILDING.md "Input scripts").
# layouts: both (also plays at 800x600: run_input_tests.py --small)
options --tutorial=diplomacy-and-intelligence --layout=1024x768 --size=1280x800

wait-lesson diplomacy-and-intelligence
# 1 Neighbours.
click item:Next in=lesson
wait-step 2
# 2 Send out an explorer: the first attack ship, Explore (at 800x600 the outlined page arrow
# first, which shows the order).
click item:next in=tag:cycle:ship
repeat 2 until { order = "explore" }
  click tag:order:explore
end
wait-step 3
# 3 A second explorer: the next ship, Explore.
click item:next in=tag:cycle:ship
click tag:order:explore
wait-step 4
# 4 First contact: end turns, sending ships that have arrived exploring again, until an empire
# is met. With no window open, Esc (which would clear the selection) does nothing, though the
# step lets the Log be closed.
key Escape refused
assert { selected = "ship" }
repeat 20 until { empires_met = 1 }
  click item:next in=tag:cycle:ship
  click tag:order:explore
  click item:next in=tag:cycle:ship
  click tag:order:explore
  click tag:button:end-turn
  click item:Yes in="End Turn"
  # The Log, if the turn has news, opens once the turn's moves in view are shown.
  wait 2
  wait-gone sector:gliding
  click tag:log:close optional
end
wait-step 5
# 5 The Empires window.
click tag:command:empires
wait-window empires
wait-step 6
# 6 The empires you know: the Trade and Tariff columns, back to Treaty, Next.
click tag:empires:trade
click tag:empires:tariff
click tag:empires:treaty
click item:Next in=lesson
wait-step 7
# 7 Open a channel: left-click the portrait.
click item:##portrait in=empires
wait-window communicate
wait-step 8
# 8 Propose a treaty: Propose Treaty in the Message Type list (its Treaty list then offers
# Non-Aggression). Sending is the next step's, so the default General Message cannot go out; Esc
# (which would close the window and lose the draft), another message type (a declaration of war)
# and the window's other buttons are refused.
click tag:communicate:send refused
key Escape refused
click item:Report in=communicate refused
assert-window communicate
assert { not = { command = "SendMessage" } }
click tag:communicate:message-type
wait-for tag:communicate:message-type:propose-treaty
click tag:communicate:message-type:declare-war refused
click item:"Propose Treaty" in=communicate
wait-step 9
assert { draft_message_type = "propose-treaty" }
assert { draft_treaty = "non-aggression" }
# 9 Send it: the type and the treaty are only to look at now; a tone, then Send Message. A few
# words in the text first: while it has the keyboard, Ctrl+Tab (another window to the front) is
# refused, and Enter only starts a new line.
click tag:communicate:message-type refused
click tag:communicate:text
type "Peace"
key Ctrl+Tab refused
key Enter
wait 3
assert-window communicate
assert { not = { command = "SendMessage" } }
click item:Pleading in=communicate
click tag:communicate:send
wait-step 10
assert { command = "SendMessage", message_type = "propose-treaty", message_treaty = "non-aggression" }
# 10 Wait for the answer: sending closed Communicate; Esc closes Empires, which the steps before
# left open and which nothing else of responds now; End Turn and Yes.
wait-closed communicate
click item:Scores in=empires refused
key Escape
wait-closed empires
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 2
# 11 Politics: the Log opened by itself at the start of the turn, with the answer in it; the
# category, the message in it, Next.
wait-window log
wait-step 11
click tag:log:politics
click item:##row in=log nth=2
click item:Next in=lesson
wait-step 12
# 12 A treaty: close the Log (nothing else of it responds), end turns until a treaty is signed or
# three turns have passed.
click tag:log:all refused
key Escape
wait-closed log
key Escape refused
repeat 4 until { any = [{ treaty = "non-aggression" }, { treaties = 1 }, { turns_passed = 3 }] }
  click tag:button:end-turn
  click item:Yes in="End Turn"
  wait 5
  click tag:log:close optional
end
wait-step 13
# 13 The Empires window again.
click tag:command:empires
wait-window empires
wait-step 14
# 14 More about other empires: the Empires window's Treaty Grid, Scores, Victory Conditions and
# Our Race, each closed again; the window's other buttons are refused. Then Next.
click item:Intelligence in=empires refused
click item:History in=empires refused
click item:"Treaty Grid" in=empires
wait-window treaty-grid
key Escape
wait-closed treaty-grid
click item:Scores in=empires
wait-window scores
key Escape
wait-closed scores
click item:"Victory Conditions" in=empires
wait-window victory-conditions
key Escape
wait-closed victory-conditions
click item:"Our Race" in=empires
wait-window race-report
key Escape
wait-closed race-report
click item:Next in=lesson
wait-step 15
# 15 Intelligence: the button in the Empires window.
click tag:empires:intelligence
wait-window intelligence
wait-step 16
# 16 A first project: a defense project; the others (none yet with this game's technology) are
# refused.
wait-for tag:intelligence:projects:defense
click tag:intelligence:projects:other refused optional
click tag:intelligence:projects:defense
wait-step 17
assert { command = "SetIntel" }
# 17 Well done: Finish. The last lesson offers the first training game, which starts from here.
click item:Finish in=lesson
wait-result done
assert-present item:"Next, a training game: Land rush*"
assert-present item:"Training Game"
click item:"Training Game"
wait-lesson land-rush
