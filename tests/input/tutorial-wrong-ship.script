# Tutorial 2, "Exploring and colonizing": the Explore order meant for an attack ship cannot go to
# the colony ship. The steps that give the order keep the selection (the ship arrows are refused),
# the ship arrows never offer the colony ship once it has its orders and has used its movement
# (spec 06 §2.3), and the step that selects the second attack ship refuses Explore until it is
# selected; the colony is still founded (docs/LEARNING.md "Conditions" and "The input lock",
# docs/BUILDING.md "Input scripts").
# layouts: both (also plays at 800x600: run_input_tests.py --small)
options --tutorial=exploring-and-colonizing --layout=1024x768 --size=1280x800

wait-lesson exploring-and-colonizing
click item:Next in=lesson
wait-step 2
click tag:command:planets
wait-window planets
wait-step 3
click tag:planets:colonizable-breathable
wait-step 4
# 4 The colony ship gets its Colonize order first.
click tag:planets:send-colony-ship
click item:* in="Select Planet to Colonize"
click item:Colonize in="Select Planet to Colonize"
wait-step 5
# 5 Select an attack ship: the next ship after the colony ship is the first attack ship.
click item:next in=tag:cycle:ship
wait-step 6
assert { selected = "ship", design_type = "Attack Ship" }
# 6 Explore: the ship arrows are refused, so the order goes to the attack ship selected.
click item:next in=tag:cycle:ship refused
click item:prev in=tag:cycle:ship refused
assert { selected = "ship", design_type = "Attack Ship" }
assert-step 6
# (At 800x600 the first click turns the order strip's page to Explore.)
repeat 2 until { order = "explore" }
  click tag:order:explore
end
wait-step 7
assert { order = "explore", design_type = "Attack Ship" }
# 7 The second attack ship. Explore is refused until it is selected. The arrows pass the colony
# ship by: back from the first attack ship comes the second.
click tag:order:explore refused
wait 30
assert-step 7
click item:prev in=tag:cycle:ship
wait-step 8
assert { selected = "ship", design_type = "Attack Ship" }
assert { not = { order = "explore", design_type = "Colony" } }
# 8 A second explorer.
click tag:order:explore
wait-step 9
click item:Next in=lesson
wait-step 10
# 10 The colony ship kept its Colonize order: the colony is founded at the end of the turn.
click tag:button:end-turn
click item:Yes in="End Turn"
wait-turn 1
wait-step 11
assert { colonies = 2 }
