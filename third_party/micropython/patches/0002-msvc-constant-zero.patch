+			return (x - x) / (x - x);  /* NaN; MSVC refuses a constant 0/0.0 */
 		if (x <= sizeof fact/sizeof *fact)
 			return fact[(int)x - 1];
 	}
@@ -187,7 +187,7 @@
 		/* n <= 0: lgamma(n)=inf with divbyzero */
 		/* n == 1,2: lgamma(n)=0 */
 		if (x <= 0)
-			return 1/0.0;
+			return 1/(x - x);  /* +inf for x == 0 and below; MSVC refuses a constant 1/0.0 */
